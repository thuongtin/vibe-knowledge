# Cấu hình quay phiên làm việc thật (turn.sh, export.py, usage.py đều đọc file này). Đường dẫn có thể dùng ~.
# Phiên chạy trong thư mục nào (bắt đầu từ thư mục trống, ví dụ ~/Desktop/<sản-phẩm>-promo)
SESSION_PROJ=~/Desktop/demo-promo
# Dùng Claude Code nào: nên dùng một bản riêng cho khóa học (thư mục cấu hình riêng, tắt tự động cập nhật), không mang vào cấu hình hằng ngày
SESSION_CC=claude
# Thư mục cấu hình của bản này (bản ghi phiên nằm dưới <thư-mục-cấu-hình>/projects/); bản dùng hằng ngày là ~/.claude
SESSION_CONFIG=~/.claude
# Chế độ quyền (quay bài dùng auto: nó tự quyết định, không hiện hộp xác nhận)
SESSION_PERMISSION=auto
# Tùy chọn: trang web chính thức để minh họa (trang tĩnh của sản phẩm hư cấu), turn.sh sẽ tự khởi động dịch vụ ở cổng này
SITE_DIR=
SITE_PORT=8930
