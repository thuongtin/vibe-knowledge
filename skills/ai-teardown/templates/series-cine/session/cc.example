#!/bin/zsh
# Kịch bản khởi động Claude Code dành riêng cho quay bài giảng (ví dụ): xoá sạch biến môi trường rồi chỉ giữ các mục cơ bản, thư mục cấu hình riêng, tắt tự động cập nhật.
# Nhờ vậy định tuyến mô hình trong cấu hình hằng ngày (như ANTHROPIC_BASE_URL) sẽ không lọt vào phiên quay bài giảng, thứ được quay chính là mô hình chính thức.
# Cách dùng: sao chép thành ~/claude-course/cc, chmod +x, rồi trong session.env ghi SESSION_CC=~/claude-course/cc, SESSION_CONFIG=~/claude-course/config.
# Lần chạy đầu tiên sẽ yêu cầu đăng nhập: việc đăng nhập và mã uỷ quyền do chính người dùng nhập trong terminal.
P="${HTTPS_PROXY:-}"
exec env -i HOME="$HOME" USER="$USER" SHELL="${SHELL:-/bin/zsh}" TERM="${TERM:-xterm-256color}" LANG=zh_CN.UTF-8 \
  PATH="$HOME/claude-course/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin" \
  ${P:+HTTPS_PROXY="$P"} ${P:+HTTP_PROXY="$P"} NO_PROXY="localhost,127.0.0.1,::1,.local" \
  CLAUDE_CONFIG_DIR="$HOME/claude-course/config" DISABLE_AUTOUPDATER=1 \
  "$HOME/claude-course/bin/claude" "$@"
