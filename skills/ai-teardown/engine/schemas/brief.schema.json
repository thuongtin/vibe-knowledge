{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-teardown.local/schemas/brief.schema.json",
  "title": "brief.json · Lập dự án",
  "description": "Nói về AI nào, cho ai xem, dài bao lâu, khung hình và lồng tiếng ra sao. Sản phẩm của bước 1, mọi bước sau đều đọc nó.",
  "type": "object",
  "required": ["subject", "audience", "duration_s", "aspects", "language", "voice", "theme", "as_of"],
  "additionalProperties": false,
  "properties": {
    "subject": {
      "type": "object",
      "required": ["name", "resolved", "archetype"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "Tên người dùng nhập, ví dụ Codex" },
        "resolved": { "type": "string", "description": "Tên đầy đủ và phạm vi của thực thể sau khi phân biệt nghĩa" },
        "not": { "type": "array", "items": { "type": "string" }, "description": "Các thực thể trùng tên bị loại trừ rõ ràng" },
        "vendor": { "type": "string" },
        "version_anchor": { "type": "string", "description": "Nói về phiên bản hoặc thế hệ mô hình nào" },
        "archetype": { "enum": ["agent", "llm", "reasoning", "generative-media", "voice", "protocol"] }
      }
    },
    "audience": { "enum": ["novice", "tech-literate", "developer"], "description": "Mặc định tech-literate: người không phải lập trình viên nhưng hiểu chút về kỹ thuật" },
    "duration_s": { "type": "integer", "minimum": 30, "maximum": 1200 },
    "depth_ceiling": { "enum": ["L2", "L3", "L4", "L5"], "default": "L4" },
    "aspects": { "type": "array", "items": { "enum": ["16:9", "9:16"] }, "minItems": 1, "uniqueItems": true },
    "fps": { "enum": [24, 30, 60], "default": 30 },
    "language": { "enum": ["zh-CN", "en-US"] },
    "voice": {
      "type": "object",
      "required": ["engine", "id"],
      "additionalProperties": false,
      "properties": {
        "engine": { "enum": ["edge-tts", "gemini", "mimo", "elevenlabs", "openai", "say", "file"] },
        "id": { "type": "string", "description": "id giọng, ví dụ zh-CN-YunxiNeural" },
        "rate": { "type": "string", "pattern": "^[+-]\\d{1,2}%$", "description": "Độ lệch tốc độ nói của edge-tts, ví dụ -5%" },
        "lexicon": { "type": "string", "description": "Đường dẫn từ điển cách đọc" }
      }
    },
    "theme": { "enum": ["blueprint", "editorial", "chalk"] },
    "bpm": { "type": "number", "minimum": 60, "maximum": 180 },
    "as_of": { "type": "string", "format": "date" },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": { "path": { "type": "string" }, "note": { "type": "string" } }
      }
    },
    "interactive": { "enum": ["none", "sync", "lab"], "default": "sync" },
    "auto": { "type": "boolean", "default": false, "description": "Khi true thì bỏ qua ba điểm xác nhận" }
  }
}
