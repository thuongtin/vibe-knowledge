{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-teardown.local/schemas/facts.schema.json",
  "title": "facts.json · sổ cái sự kiện",
  "description": "Sự kiện nguyên tử, mỗi mục chỉ nói một việc, mỗi mục kèm trích đoạn nguyên văn. Sản phẩm của bước 3; lời dẫn và hình ảnh chỉ được trích dẫn sự kiện ở đây.",
  "type": "object",
  "required": ["as_of", "facts"],
  "additionalProperties": false,
  "properties": {
    "as_of": { "type": "string", "format": "date" },
    "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" }, "minItems": 1 }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["source", "quote"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "pattern": "^S\\d{2,3}$" },
        "quote": { "type": "string", "minLength": 1, "maxLength": 400 },
        "where": { "type": "string", "description": "Tên tiểu mục, số dòng hoặc timecode" }
      }
    },
    "fact": {
      "type": "object",
      "required": ["id", "claim", "category", "status", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^F\\d{3}$" },
        "claim": { "type": "string", "minLength": 4, "maxLength": 80, "description": "Một câu sự kiện nguyên tử, nên dưới 60 chữ" },
        "category": { "enum": ["what", "how", "why", "limit", "number", "date", "name", "compare", "ui"] },
        "status": { "enum": ["verified", "single-source", "conflict", "inferred", "undisclosed"] },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "numbers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value"],
            "additionalProperties": false,
            "properties": { "value": { "type": "string" }, "unit": { "type": "string" } }
          }
        },
        "terms": { "type": "array", "items": { "type": "string" }, "description": "Danh từ riêng, dùng cho từ điển cách đọc và đối chiếu từng chữ" },
        "as_of": { "type": "string", "format": "date" },
        "supersedes": { "type": "string", "pattern": "^F\\d{3}$" },
        "notes": { "type": "string" }
      },
      "if": { "properties": { "status": { "const": "undisclosed" } } },
      "then": { "properties": { "evidence": { "minItems": 0 } } },
      "else": { "properties": { "evidence": { "minItems": 1 } } }
    }
  }
}
