{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-teardown.local/schemas/concepts.schema.json",
  "title": "concepts.json · Mô hình hóa tri thức",
  "description": "Sơ đồ tổng, khái niệm và quan hệ tiên quyết, các hiểu lầm thường gặp, mục tiêu học tập. Đầu ra của bước 4.",
  "type": "object",
  "required": ["archetype", "master_map", "concepts", "objectives"],
  "additionalProperties": false,
  "properties": {
    "archetype": { "enum": ["agent", "llm", "reasoning", "generative-media", "voice", "protocol"] },
    "master_map": {
      "type": "object",
      "required": ["nodes", "edges"],
      "additionalProperties": false,
      "properties": {
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" }, "minItems": 2 },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
      }
    },
    "concepts": { "type": "array", "items": { "$ref": "#/$defs/concept" }, "minItems": 1 },
    "misconceptions": { "type": "array", "items": { "$ref": "#/$defs/misconception" } },
    "objectives": { "type": "array", "items": { "$ref": "#/$defs/objective" }, "minItems": 3 }
  },
  "$defs": {
    "factRefs": { "type": "array", "items": { "type": "string", "pattern": "^F\\d{3}$" } },
    "honesty": { "enum": ["official", "inferred", "undisclosed"] },
    "node": {
      "type": "object",
      "required": ["id", "label", "role"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "label": { "type": "string", "maxLength": 12 },
        "role": { "enum": ["user", "model", "tool", "env", "boundary"] },
        "parent": { "type": "string", "description": "id của nút cha chứa nó sau khi đẩy vào một tầng; nút tầng trên cùng thì không ghi" },
        "honesty": { "$ref": "#/$defs/honesty" },
        "facts": { "$ref": "#/$defs/factRefs" }
      }
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "label"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "label": { "type": "string", "maxLength": 10, "description": "Động tác trên mũi tên, như gọi, trả về đầu ra" },
        "honesty": { "$ref": "#/$defs/honesty" },
        "facts": { "$ref": "#/$defs/factRefs" }
      }
    },
    "concept": {
      "type": "object",
      "required": ["id", "term", "plain", "level", "prereqs", "facts"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^C\\d{2}$" },
        "term": { "type": "string", "description": "Thuật ngữ, như vòng lặp Agent" },
        "plain": { "type": "string", "maxLength": 40, "description": "Một câu giải thích dễ hiểu" },
        "analogy": { "type": "string" },
        "level": { "enum": ["L0", "L1", "L2", "L3", "L4", "L5"] },
        "node": { "type": "string", "description": "id nút tương ứng của sơ đồ tổng" },
        "prereqs": { "type": "array", "items": { "type": "string", "pattern": "^C\\d{2}$" } },
        "facts": { "$ref": "#/$defs/factRefs" }
      }
    },
    "misconception": {
      "type": "object",
      "required": ["id", "myth", "truth", "facts"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^M\\d{2}$" },
        "myth": { "type": "string" },
        "truth": { "type": "string" },
        "facts": { "$ref": "#/$defs/factRefs" }
      }
    },
    "objective": {
      "type": "object",
      "required": ["id", "question", "answer", "concepts"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^Q\\d{2}$" },
        "question": { "type": "string", "description": "Câu hỏi dùng cho bài kiểm tra mù khi đọc lạnh, chỉ xem bản thuyết trình và khung hình then chốt là phải trả lời được" },
        "answer": { "type": "string" },
        "concepts": { "type": "array", "items": { "type": "string", "pattern": "^C\\d{2}$" }, "minItems": 1 }
      }
    }
  }
}
