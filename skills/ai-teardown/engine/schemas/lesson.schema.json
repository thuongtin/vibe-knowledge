{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-teardown.local/schemas/lesson.schema.json",
  "title": "lesson.json · Giáo án (file nguồn duy nhất)",
  "description": "Chương và beat. Lời dẫn, từ khóa lên màn hình, nguyên thủy và tham số, nguồn đều ở đây; video và bài giảng tương tác đều được biên dịch từ nó. Đầu ra của bước 5, sau khi lồng tiếng thì điền ngược lại audio.",
  "type": "object",
  "required": [
    "meta",
    "chapters",
    "beats"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "title",
        "subject",
        "as_of",
        "aspect",
        "fps",
        "theme",
        "voice"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "aspect": {
          "enum": [
            "16:9",
            "9:16"
          ]
        },
        "fps": {
          "enum": [
            24,
            30,
            60
          ]
        },
        "theme": {
          "enum": [
            "blueprint",
            "editorial",
            "chalk"
          ]
        },
        "voice": {
          "type": "string"
        },
        "bpm": {
          "type": "number"
        },
        "pace_cps": {
          "type": "number",
          "minimum": 2.5,
          "maximum": 5,
          "default": 3.5,
          "description": "Tốc độ nói mục tiêu, chữ/giây"
        }
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chapter"
      },
      "minItems": 1
    },
    "beats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/beat"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "factRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^F\\d{3}$"
      }
    },
    "chapter": {
      "type": "object",
      "required": [
        "id",
        "title",
        "level",
        "beats"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CH\\d{2}$"
        },
        "title": {
          "type": "string",
          "maxLength": 16
        },
        "level": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4",
            "L5",
            "R"
          ]
        },
        "focus_node": {
          "type": "string",
          "description": "Chương này đẩy góc máy tới nút nào của sơ đồ tổng"
        },
        "beats": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^B\\d{3}$"
          },
          "minItems": 1
        }
      }
    },
    "cue": {
      "type": "object",
      "required": [
        "name",
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "Tương ứng với dấu [[name]] trong lời dẫn"
        },
        "action": {
          "type": "string",
          "description": "Móc nguyên thủy, như reveal:model, press, state:3"
        }
      }
    },
    "visual": {
      "type": "object",
      "required": [
        "primitive"
      ],
      "additionalProperties": false,
      "properties": {
        "primitive": {
          "enum": [
            "SystemMap",
            "Pipeline",
            "Loop",
            "Terminal",
            "ChatUI",
            "CodeDiff",
            "Cursor",
            "Sandbox",
            "Analogy",
            "Compare",
            "Metric",
            "ConceptMap",
            "Morph",
            "Sequence",
            "Timeline",
            "Layers",
            "Exploded",
            "TokenStream",
            "ContextWindow",
            "Quiz",
            "Title",
            "Free"
          ]
        },
        "params": {
          "type": "object"
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "focus": {
              "type": "string"
            },
            "zoom": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 12
            }
          }
        },
        "honesty": {
          "enum": [
            "official",
            "inferred",
            "undisclosed"
          ],
          "default": "official"
        },
        "ui_mock": {
          "type": "boolean",
          "default": false,
          "description": "Khi true thì góc ghi \"Minh họa giao diện\""
        },
        "continues": {
          "type": "boolean",
          "default": false,
          "description": "Khi true thì dùng tiếp thể hiện nguyên thủy của beat trước, không dựng lại"
        }
      }
    },
    "beat": {
      "type": "object",
      "required": [
        "id",
        "chapter",
        "move",
        "narration",
        "visual",
        "facts"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^B\\d{3}$"
        },
        "chapter": {
          "type": "string",
          "pattern": "^CH\\d{2}$"
        },
        "move": {
          "enum": [
            "hook",
            "ask",
            "show",
            "name",
            "place",
            "compare",
            "recap",
            "quiz",
            "transition",
            "end"
          ],
          "description": "Bốn nhịp: ask=hỏi show=trình diễn name=gọi tên place=quy về"
        },
        "concept": {
          "type": "string",
          "pattern": "^C\\d{2}$",
          "description": "Khái niệm lần đầu được đưa vào ở beat này, nhiều nhất một cái"
        },
        "narration": {
          "type": "string",
          "description": "Lời dẫn; dùng [[tên cue]] đánh dấu vị trí căn khớp với động tác của hình ảnh"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 12
          },
          "maxItems": 3,
          "description": "Từ khóa lên màn hình, ≤ 3 cái; mỗi cái không quá 8 chữ Hán, tiếng Anh quy đổi theo độ rộng tối đa 12 ký tự"
        },
        "visual": {
          "$ref": "#/$defs/visual"
        },
        "cues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cue"
          }
        },
        "facts": {
          "$ref": "#/$defs/factRefs"
        },
        "min_hold_s": {
          "type": "number",
          "minimum": 0,
          "default": 0.6
        },
        "audio": {
          "type": "object",
          "description": "Script điền ngược lại sau khi lồng tiếng",
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string"
            },
            "start_s": {
              "type": "number"
            },
            "duration_s": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
